{
	"name": "@spamalot/root",
	"version": "0.0.0",
	"private": true,
	"description": "Source and Package Administration/Management",
	"author": "James Prevett <jp@jamespre.dev>",
	"license": "GPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/james-pre/spamalot.git"
	},
	"homepage": "https://github.com/james-pre/spamalot#readme",
	"bugs": {
		"url": "https://github.com/james-pre/spamalot/issues"
	},
	"type": "module",
	"workspaces": [
		"packages/core",
		"packages/npm",
		"packages/dnf",
		"packages/flatpak",
		"packages/cli"
	],
	"scripts": {
		"build": "tsc -b",
		"watch": "tsc -b -w",
		"clean": "rm -rf packages/*/dist packages/*/tsconfig.tsbuildinfo",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@commander-js/extra-typings": "^15.0.0",
		"@james-pre/monorepo": "^1.0.0",
		"@types/node": "^25.5.2",
		"@types/semver": "^7.7.1",
		"prettier": "^3.6.2",
		"typescript": "^6.0.0"
	},
	"prettier": {
		"singleQuote": true,
		"useTabs": true,
		"trailingComma": "es5",
		"tabWidth": 4,
		"printWidth": 140,
		"arrowParens": "avoid",
		"experimentalOperatorPosition": "start"
	}
}
