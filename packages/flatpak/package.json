{
	"name": "@spamalot/flatpak",
	"version": "0.1.0",
	"description": "Flatpak package manager support for spamalot",
	"author": "James Prevett <jp@jamespre.dev>",
	"license": "GPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/james-pre/spamalot.git",
		"directory": "packages/flatpak"
	},
	"homepage": "https://github.com/james-pre/spamalot/tree/main/packages/flatpak#readme",
	"bugs": {
		"url": "https://github.com/james-pre/spamalot/issues"
	},
	"type": "module",
	"keywords": [
		"flatpak",
		"package-manager"
	],
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": "./dist/index.js",
		"./*": "./dist/*.js"
	},
	"files": [
		"dist",
		"native",
		"README.md"
	],
	"os": [
		"linux"
	],
	"cpu": [
		"x64"
	],
	"scripts": {
		"prepare": "girbind build",
		"build": "tsc -b"
	},
	"dependencies": {
		"@spamalot/core": "^0.1.0",
		"girbind": "^0.3.1",
		"ioium": "^1.0.0"
	},
	"devDependencies": {
		"girbind-devel": "^0.3.1"
	},
	"girbindDependencies": [
		"flatpak"
	],
	"publishConfig": {
		"provenance": true,
		"access": "public"
	}
}
