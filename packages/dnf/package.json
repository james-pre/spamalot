{
	"name": "@spamalot/dnf",
	"version": "0.1.0",
	"description": "dnf package manager support for spamalot",
	"author": "James Prevett <jp@jamespre.dev>",
	"license": "GPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/james-pre/spamalot.git",
		"directory": "packages/dnf"
	},
	"homepage": "https://github.com/james-pre/spamalot/tree/main/packages/dnf#readme",
	"bugs": {
		"url": "https://github.com/james-pre/spamalot/issues"
	},
	"type": "module",
	"keywords": [
		"dnf",
		"package-manager"
	],
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": "./dist/index.js",
		"./*": "./dist/*.js"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsc -b"
	},
	"dependencies": {
		"@spamalot/core": "^0.1.0",
		"libdnf": "^0.4.0"
	},
	"publishConfig": {
		"provenance": true,
		"access": "public"
	}
}
