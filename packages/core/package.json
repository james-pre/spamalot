	"description": "Package management abstractions shared by spamalot backends and frontends",
	"author": "James Prevett <jp@jamespre.dev>",
	"license": "GPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/james-pre/spamalot.git",
		"directory": "packages/core"
	},
	"homepage": "https://github.com/james-pre/spamalot/tree/main/packages/core#readme",
